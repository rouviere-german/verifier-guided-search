# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=verifier-guided-search
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of API keys.
# Generate a key with: uv run verifier-guided-search generate-api-key
APP_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# Agentic kit. Tests, demo and bench run offline and never need a key.
ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-opus-5
APP_LLM_EFFORT=high
APP_LLM_MAX_RETRIES=2
APP_LLM_TIMEOUT_SECONDS=600
APP_LLM_REFUSAL_FALLBACK=true
APP_BUDGET_MAX_STEPS=50
APP_BUDGET_MAX_TOKENS=200000
APP_BUDGET_MAX_USD=1.0

# Verifier sandbox. Unset APP_RUNNER_URL runs the sandbox in this process (tests, demo, bench);
# docker-compose sets it to the runner container on the internal network.
APP_RUNNER_URL=
APP_RUNNER_API_KEY=
APP_RUNNER_TIMEOUT_SECONDS=30
APP_SANDBOX_TIMEOUT_SECONDS=1.5
APP_SANDBOX_MEMORY_BYTES=268435456
# Runner only: the tmpfs mount that holds the sandbox jail.
APP_RUNNER_WORKROOT=/sandbox
# Concurrent candidate executions before the runner answers 503.
APP_RUNNER_MAX_CONCURRENT_EXECUTIONS=4

# Search API limits.
# mutation (offline, no key) or claude (live, needs ANTHROPIC_API_KEY).
APP_GENERATOR=mutation
APP_GENERATOR_MODEL=claude-sonnet-5
APP_SEARCH_MAX_CANDIDATES=16
APP_SEARCH_DEFAULT_STRATEGY=mcts
# Concurrent searches before the service answers 503.
APP_SEARCH_MAX_CONCURRENT_SEARCHES=2
# Pin a value-model version (64 hex chars); unset follows the registry pointer.
APP_VALUE_MODEL_VERSION=

APP_DATA_DIR=var
